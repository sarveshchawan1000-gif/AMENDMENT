# AMENDMENT Backend Configuration
# Copy this to .env and customize for your environment

# ============================================================================
# COURT AI PROVIDER
# ============================================================================

# Provider selection: "ollama" for local, "gemini" for Google hosted, "groq" for Groq hosted
# For dual-provider fallback, configure primary and secondary/fallback providers:
COURT_PRIMARY_PROVIDER=gemini
COURT_FALLBACK_PROVIDER=groq
# Backward compatibility fallback:
# COURT_PROVIDER=ollama

# ============================================================================
# OLLAMA CONFIGURATION (local development)
# ============================================================================

# Ollama server URL
OLLAMA_URL=http://localhost:11434

# Model name (must be installed: ollama pull gemma3:4b)
OLLAMA_MODEL=gemma3:4b

# Request timeout in seconds
OLLAMA_TIMEOUT=30

# ============================================================================
# GROQ CONFIGURATION (hosted AI provider)
# ============================================================================

# Groq API key (required when COURT_PROVIDER=groq)
# Read exclusively from environment; never commit real credentials
# GROQ_API_KEY=your_groq_api_key_here

# Groq supported model name (default: openai/gpt-oss-120b)
# Supported options: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# Request timeout in seconds
GROQ_TIMEOUT=15

# ============================================================================
# GEMINI CONFIGURATION (production deployment)
# ============================================================================

# Google API key (required when COURT_PROVIDER=gemini)
# Get from: https://ai.google.dev/
# GEMINI_API_KEY=your_gemini_api_key_here

# Model name (default: gemini-3.1-flash-lite, supported: gemini-3.1-flash-lite, gemini-3.5-flash, gemini-flash-latest)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Request timeout in seconds
# GEMINI_TIMEOUT=15

# ============================================================================
# RULE CACHE SETTINGS
# ============================================================================

# Persistent SQLite database path for compiled & validated rules
# RULE_CACHE_DB_PATH=data/rule_cache.db

# ============================================================================
# GENERATION SETTINGS
# ============================================================================

# Temperature: 0.0 = deterministic, 1.0 = creative
COURT_TEMPERATURE=0.0

# Maximum retry attempts for failed generations
COURT_MAX_RETRIES=1
