# AMENDMENT Backend Configuration
# Copy this to .env and customize for your environment

# ============================================================================
# COURT AI PROVIDER
# ============================================================================

# Provider selection: "ollama" for local, "gemini" for hosted
COURT_PROVIDER=ollama

# ============================================================================
# OLLAMA CONFIGURATION (local development)
# ============================================================================

# Ollama server URL
OLLAMA_URL=http://localhost:11434

# Model name (must be installed: ollama pull gemma3:4b)
OLLAMA_MODEL=gemma3:4b

# Request timeout in seconds
OLLAMA_TIMEOUT=30

# Generation options
OLLAMA_SEED=42
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=512

# ============================================================================
# GEMINI CONFIGURATION (production deployment)
# ============================================================================

# Google API key (required when COURT_PROVIDER=gemini)
# Get from: https://ai.google.dev/
# GEMINI_API_KEY=your-api-key-here

# Model name
# GEMINI_MODEL=gemini-2.0-flash-exp

# Request timeout in seconds
# GEMINI_TIMEOUT=15

# ============================================================================
# GENERATION SETTINGS
# ============================================================================

# Temperature: 0.0 = deterministic, 1.0 = creative
COURT_TEMPERATURE=0.0

# Maximum retry attempts for failed generations
COURT_MAX_RETRIES=1
