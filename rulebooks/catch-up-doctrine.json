{
  "name": "The Catch-Up Doctrine",
  "board_sizes": [6, 8, 10],
  "rules": [
    {
      "id": "AMEND_065",
      "trigger": "on_land",
      "condition": {
        "mode": "all",
        "predicates": [
          { "name": "is_last" }
        ]
      },
      "effect": {
        "type": "add_score",
        "amount": 2,
        "target": "self"
      },
      "source": "Gain +2 points upon landing if you are in last place."
    },
    {
      "id": "AMEND_004",
      "trigger": "on_roll",
      "condition": {
        "mode": "all",
        "predicates": [
          { "name": "roll_is_even" }
        ]
      },
      "effect": {
        "type": "steal_score",
        "amount": 1,
        "target": "last"
      },
      "source": "When you roll an even number, transfer 1 point from the leader to last place."
    }
  ]
}
