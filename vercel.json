{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/game/(.*)", "destination": "/api/server.py" },
    { "source": "/court/(.*)", "destination": "/api/server.py" },
    { "source": "/rulebooks", "destination": "/api/server.py" },
    { "source": "/api/(.*)", "destination": "/api/server.py" },
    { "source": "/docs", "destination": "/api/server.py" },
    { "source": "/openapi.json", "destination": "/api/server.py" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
